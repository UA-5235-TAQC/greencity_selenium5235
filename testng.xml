<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TestSuite" parallel="methods" thread-count="3" verbose="1">
    <!--
      Suite that runs all tests found under the test classes package.
      Adjust thread-count as needed for CI/runner resources.
    -->
    <test name="UI Tests">
        <classes>
            <class name="org.greencity.ui.CreateNews.CancelCreatingTest"/>
            <class name="org.greencity.ui.CreateNews.CreateNewsFormVisibilityTestEN"/>
            <class name="org.greencity.ui.CreateNews.CreateNewsFormVisibilityTestUA"/>
            <class name="org.greencity.ui.CreateNews.ContentValidationTest"/>
            <class name="org.greencity.ui.CreateNews.SourceValidationTest"/>
            <class name="org.greencity.ui.CreateNews.TitleValidationTest"/>
            <class name="org.greencity.ui.CreateNews.UploadImageTest"/>
            <class name="org.greencity.ui.CreateNews.PreviewPageTest"/>

            <class name="org.greencity.ui.EditNews.EditNewsFormVisibilityTestEN"/>
            <class name="org.greencity.ui.EditNews.EditNewsFormVisibilityTestUA"/>
            <class name="org.greencity.ui.EditNews.CancelEditingTest"/>

            <class name="org.greencity.ui.FirstTest"/>
            <class name="org.greencity.ui.FirstTestWithUser"/>
            <class name="org.greencity.ui.TagSelectionTest"/>
        </classes>
    </test>
    <test name="API Tests">
        <classes>
            <class name="org.greencity.api.OwnSecurityTest"/>
            <class name="org.greencity.api.CreateEcoNewsTest"/>
            <class name="org.greencity.api.EcoNewsTest"/>
            <class name="org.greencity.api.EcoNewsById.DeleteEcoNewsByIdTest"/>
            <class name="org.greencity.api.EcoNewsById.EcoNewsByIdWithImageTest"/>
            <class name="org.greencity.api.EcoNewsById.UnauthorizedEcoNewsByIdTest"/>
            <class name="org.greencity.api.EcoNewsById.UpdateEcoNewsByIdWithoutImageTest"/>
            <class name="org.greencity.api.ecoNewsComment.EcoNewsCommentRepliesTest"/>
            <class name="org.greencity.api.EcoNewsById.FavoriteEcoNewsWithTokenTest"/>
            <class name="org.greencity.api.EcoNewsById.FavoriteEcoNewsWithoutTokenTest"/>
        </classes>
    </test>
</suite>
